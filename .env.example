# Sanity
# NEXT_PUBLIC_SANITY_DATASET="production"
# NEXT_PUBLIC_SANITY_PROJECT_ID="xxxxxxx"

# Brandfetch Logo CDN (social icons in the top nav)
# Free Client ID: https://developers.brandfetch.com/register
# NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=
# Optional Brand API key for richer Studio logo picker results (Bearer token)
# BRANDFETCH_API_KEY=

# Medusa storefront (Shop at /shop) — backend at shopadmin.dragonspurr.ca
# Use a Dragons Veil–specific publishable API key from Medusa Admin.
# MEDUSA_BACKEND_URL=https://shopadmin.dragonspurr.ca
# MEDUSA_PUBLISHABLE_KEY=pk_...
# NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...
# Region used for product prices, new carts, and checkout (Medusa Admin → Settings → Regions)
# MEDUSA_DEFAULT_REGION_ID=reg_...

# Stripe (must match Medusa backend; enable Stripe on the region in Medusa Admin)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# OVH S3-compatible object storage (shared credentials for all buckets)
# OVH_S3_ENDPOINT=https://s3.ca-east-tor.io.cloud.ovh.net
# OVH_S3_REGION=ca-east-tor
# OVH_S3_ACCESS_KEY=
# OVH_S3_SECRET_KEY=

# User assets bucket (customer profile photos)
# OVH_USER_ASSETS_S3_BUCKET=dp-user-assets
# OVH_USER_ASSETS_PUBLIC_URL=https://dp-user-assets.s3.ca-east-tor.io.cloud.ovh.net

# Site assets bucket (logos, static images — Dragon's Veil brand files)
# OVH_SITE_ASSETS_S3_BUCKET=dp-dv-assets
# OVH_SITE_ASSETS_PUBLIC_URL=https://dp-dv-assets.s3.ca-east-tor.io.cloud.ovh.net

# Google Maps Platform (address autocomplete on shop account address form)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Sentry (error monitoring, tracing, session replay)
# NEXT_PUBLIC_SENTRY_DSN=https://...@....ingest....sentry.io/...
# SENTRY_DSN=https://...@....ingest....sentry.io/...
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=sntrys_...  # project:releases + org:read scopes; use .env.sentry-build-plugin locally
